{
  "name": "ctd-relay",
  "version": "0.2.0",
  "description": "Self-hosted multistreaming: landscape + vertical from OBS to every platform, one title, one chat.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "vite",
    "dev:sim": "tsx scripts/dev-sim.mts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "setup-tools": "node scripts/setup-tools.mjs",
    "smoke": "tsx scripts/smoke-test.ts",
    "cli": "tsx server/src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "acme-client": "^5.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
